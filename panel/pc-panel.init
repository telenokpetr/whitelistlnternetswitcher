#!/bin/sh /etc/rc.common
START=97
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -p 192.168.1.1:8088 -h /www-panel -x /cgi-bin -c /etc/pc/httpd.conf -t 120 -T 30 -I index.html
	procd_set_param respawn
	procd_close_instance
	procd_open_instance pcd
	procd_set_param command /usr/bin/pc-daemon.sh
	procd_set_param respawn
	procd_close_instance
}
